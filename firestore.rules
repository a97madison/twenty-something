rules_version = '2';

// Default deny. The server is the only writer: every authoritative mutation
// (daily/room scoring, the daily-game percentile read) goes through a Cloud
// Function using the Admin SDK, which BYPASSES these rules. Clients never read
// or write Firestore directly — that is what keeps scoring un-spoofable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
