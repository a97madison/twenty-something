# Dependencies (regenerated by npm install)
node_modules/

# Build output (regenerated by npm run build)
dist/
*.tsbuildinfo

# Lockfile is committed by convention; remove the next line if you prefer not to
# (kept here as a reminder — package-lock.json SHOULD normally be committed)

# Expo / React Native
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# Native build artifacts (if you ever prebuild)
apps/*/ios/
apps/*/android/

# Firebase
functions/lib/
.firebase/
firebase-debug.log
*-debug.log

# Environment / secrets
.env
.env.*
!.env.example

# Notes (local working memory, not shared)
notes.md

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Spine and session history stay LOCAL. This repo is public, and a spine is working notes:
# roadmap, blockers, and in this case a plainly stated live weakness ("anyone can mint an anon
# token + submit"). notes.md was already local-only; STATE.md and journal/ belong with it.
# They still exist on disk and still auto-inject at SessionStart. They just are not published.
STATE.md
journal/
