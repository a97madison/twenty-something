{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@twenty-something/core": ["../../packages/core/src/index.ts"]
    }
  },
  "include": ["index.ts", "src/**/*.ts", "src/**/*.tsx"]
}
